{
  "name": "spotify-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Оверлей і док для OBS: што грае ў Spotify і заказ песень за баллы канала Twitch.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "deploy:next": "npm run build && node scripts/deploy.mjs next"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mashninski/spotify-bot.git"
  },
  "license": "MIT",
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "deploy": {
    "repo": "https://github.com/mashninski/spotify-bot.git"
  }
}

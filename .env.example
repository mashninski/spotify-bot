# Узор зменных асяроддзя. Рэальныя значэнні — толькі ў файле .env (ён у .gitignore).
# Спіс будзе ўдакладнены пасля агляду існуючага кода spotify-bot.

# Twitch (рэгістрацыя Application — Этап 3)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# OBS WebSocket (Этап 2); стандартны порт obs-websocket 5.x — 4455
OBS_WEBSOCKET_HOST=localhost
OBS_WEBSOCKET_PORT=4455
OBS_WEBSOCKET_PASSWORD=
